# Prometheus 알람 규칙.
#
# Ansible 이 처음 한 번만 배포한다(force: false). 플레이북을 다시 돌려도
# 여기에 쓴 규칙은 덮어쓰이지 않는다.
#
# ── 이 파일은 실습에서 채운다 ────────────────────────────────
# 아래 예시 한 건만 들어 있다. 나머지는 수강생이 직접 쓴다.
# 고친 뒤에는 Prometheus 에 다시 읽힌다.
#
#   sudo systemctl reload prometheus
#   또는 sudo systemctl restart prometheus
#
# 문법이 틀리면 Prometheus 가 뜨지 않는다. 로그에서 파싱 오류를 본다.
#
#   sudo journalctl -u prometheus -n 30
#
# ── 규칙 하나의 구성 ─────────────────────────────────────────
#   expr                  참이면 조건 충족
#   for                   그 시간만큼 계속 참이어야 발동
#   labels.severity       page / ticket / dashboard 중 하나
#   annotations.runbook   받은 사람이 어느 런북을 펼지

groups:
  - name: lab
    rules:
      # 디스크가 차는 것은 미리 알 수 있는 몇 안 되는 장애다.
      # 남은 양이 아니라 줄어드는 속도로 건다. predict_linear 가 최근 6시간의
      # 기울기로 24시간 뒤를 내다보고, 그 값이 음수면 그 전에 0이 된다는 뜻이다.
      #
      # 데이터 디스크만 본다. OS 디스크를 넣으면 스택을 갓 올린 직후에
      # 패키지 설치로 줄어든 기울기를 24시간으로 늘려 잡아 곧바로 발동한다.
      # 수강생이 규칙을 쓰기도 전에 Alerts 화면이 pending 으로 시작한다.
      - alert: DiskWillFillIn24h
        expr: predict_linear(node_filesystem_avail_bytes{mountpoint=~"/var/lib/.*"}[6h], 24 * 3600) < 0
        for: 30m
        labels:
          severity: ticket
        annotations:
          summary: "{% raw %}{{ $labels.instance }} 의 {{ $labels.mountpoint }} 가 24시간 안에 찹니다{% endraw %}"
          runbook: "RB-OBS"

      # ── 여기부터 수강생이 채운다 ─────────────────────────────
      #
      # Redis 메모리 사용률
      #   - alert: RedisMemoryHigh
      #     expr: ...
      #     for: ...
      #     labels:
      #       severity: ...
      #     annotations:
      #       summary: "..."
      #       runbook: "RB-R02"
      #
      # Redis replica 수
      #   runbook: "RB-R01"
      #
      # MongoDB 복제 지연     (2단계에서)
      #   runbook: "RB-M01"
      #
      # MongoDB 멤버 상태     (2단계에서)
      #   멤버가 완전히 끊기면 optimeDate 가 1970-01-01 이 되어 위 지연 식의
      #   > 0 필터가 그 멤버를 제외한다. 지연 규칙만으로는 가장 나쁜 상태에서
      #   아무것도 울리지 않으므로 mongodb_members_health 를 짝으로 건다.
      #   runbook: "RB-M01"
      #
      # Consumer Lag          (3단계에서)
      #   runbook: "RB-K01"
