# ops 노드에서만 돈다. 서비스 노드의 exporter 를 긁어 온다.
#
# 인벤토리에 있는 그룹만 job 으로 낸다. 세션마다 인벤토리가 다르므로
# 없는 그룹을 순회하면 그 자리에서 플레이북이 멈춘다.

global:
  scrape_interval: 15s
  scrape_timeout: 10s

scrape_configs:
{% if 'redis' in groups %}
{%   set svc_group = 'redis' %}{% set svc_name = 'redis' %}{% set svc_port = 9121 %}
{% elif 'mongo' in groups %}
{%   set svc_group = 'mongo' %}{% set svc_name = 'mongodb' %}{% set svc_port = 9216 %}
{% elif 'kafka' in groups %}
{%   set svc_group = 'kafka' %}{% set svc_name = 'kafka' %}{% set svc_port = 9308 %}
{% else %}
{%   set svc_group = none %}
{% endif %}
{% if svc_group %}
  - job_name: node
    static_configs:
      - targets:
{% for host in groups[svc_group] %}
          - "{{ hostvars[host].ansible_host }}:9100"
{% endfor %}
{% for extra in ['configsvr', 'shard2'] if extra in groups %}
{% for host in groups[extra] %}
          - "{{ hostvars[host].ansible_host }}:9100"
{% endfor %}
{% endfor %}
        labels:
          service: {{ svc_name }}

  - job_name: {{ svc_name }}
    static_configs:
      - targets:
{% for host in groups[svc_group] %}
          - "{{ hostvars[host].ansible_host }}:{{ svc_port }}"
{% endfor %}
{% for extra in ['configsvr', 'shard2'] if extra in groups %}
{% for host in groups[extra] %}
          - "{{ hostvars[host].ansible_host }}:{{ svc_port }}"
{% endfor %}
{% endfor %}
        labels:
          service: {{ svc_name }}
{% if svc_group == 'kafka' %}

  # 브로커 JVM 안의 java agent. kafka_exporter 가 내지 않는 MBean 값이 여기서 나온다.
  - job_name: kafka_jmx
    static_configs:
      - targets:
{% for host in groups['kafka'] %}
          - "{{ hostvars[host].ansible_host }}:{{ kafka_jmx_exporter_port | default(9404) }}"
{% endfor %}
        labels:
          service: kafka
{% endif %}
{% endif %}
