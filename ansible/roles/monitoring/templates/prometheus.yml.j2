# ops 노드에서만 돈다. 서비스 노드의 exporter 를 긁어 온다.
#
# 관측 대상은 tasks 의 「관측 대상 서비스 판정」이 정한다. 인벤토리에 있는
# 그룹만 job 으로 낸다. 없는 그룹을 순회하면 그 자리에서 플레이북이 멈춘다.
#
# 세션 1 부터 세션 3 은 서비스 그룹이 하나뿐이라 job 이 한 벌 나오고,
# 세션 4 의 04-operation 은 세 벌이 나온다.

global:
  scrape_interval: 15s
  scrape_timeout: 10s

# 알람 규칙 파일. Ansible 이 뼈대만 놓고 수강생이 채운다.
# 파일이 없어도 Prometheus 는 뜬다. 경고 한 줄만 남는다.
rule_files:
  - /etc/prometheus/alert-rules.yml

scrape_configs:
{% if monitoring_present | default([]) %}
  - job_name: node
    static_configs:
{% for svc in monitoring_present %}
      - targets:
{% for group in monitoring_catalog[svc].node_groups if groups[group] | default([]) | length > 0 %}
{% for host in groups[group] %}
          - "{{ hostvars[host].ansible_host }}:9100"
{% endfor %}
{% endfor %}
        labels:
          service: {{ svc }}
{% endfor %}
{% if monitoring_scrape_ops | bool %}
      # Prometheus 가 이 노드에서 돈다. 부하 발생기도 여기서 돌므로 자원을 함께 본다.
      - targets:
          - "127.0.0.1:9100"
        labels:
          service: ops
{% endif %}
{% for svc in monitoring_present %}

  - job_name: {{ svc }}
    static_configs:
      - targets:
{% for group in monitoring_catalog[svc].node_groups if groups[group] | default([]) | length > 0 %}
{% for host in groups[group] %}
          - "{{ hostvars[host].ansible_host }}:{{ monitoring_catalog[svc].exporter_port }}"
{% endfor %}
{% endfor %}
        labels:
          service: {{ svc }}
{% endfor %}
{% if 'kafka' in monitoring_present %}

  # 브로커 JVM 안의 java agent. kafka_exporter 가 내지 않는 MBean 값이 여기서 나온다.
  - job_name: kafka_jmx
    static_configs:
      - targets:
{% for host in groups['kafka'] %}
          - "{{ hostvars[host].ansible_host }}:{{ kafka_jmx_exporter_port | default(9404) }}"
{% endfor %}
        labels:
          service: kafka
{% endif %}
{% endif %}
